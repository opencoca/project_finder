        },
        {
          "checked": false,
          "line_num": 40,
          "tags": [],
          "text": "In `main` loop, when both `output_path` and shadow exist, call merge instead of direct write"
        },
        {
          "checked": false,
          "line_num": 41,
          "tags": [],
          "text": "Fall back to direct write when shadow is missing (first run after migration) or when output_path doesn't exist"
        },
        {
          "checked": false,
          "line_num": 42,
          "tags": [],
          "text": "Track per-file outcome (clean vs. conflict) and pass to M4's logger"
        },
        {
          "checked": false,
          "line_num": 43,
          "tags": [],
